# --- Core ---
PORT=8089
NODE_ENV=development

# --- MongoDB Atlas (required for authentication, accounts and persistence) ---
MONGODB_URI=
# MONGODB_DB_NAME=bp-learning

# --- Session security ---
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=7

# --- DeepSeek AI ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- TTS (optional, Python edge-tts service) ---
TTS_SERVICE_URL=http://127.0.0.1:8765

# --- Registration / roles ---
# Set to false to make registration admin-controlled only
ALLOW_PUBLIC_REGISTRATION=true
# Comma-separated emails that get the admin role when they self-register (dev convenience)
ADMIN_EMAILS=

# --- Emails ---
# Base URL used to build password reset / verification links
APP_BASE_URL=http://127.0.0.1:8089
EMAIL_FROM=no-reply@bp-learning.local
# console (dev log) | http (POST JSON {to,from,subject,text} to EMAIL_HTTP_URL) | smtp (Gmail)
EMAIL_TRANSPORT=console
EMAIL_HTTP_URL=
RESET_TOKEN_TTL_MINUTES=60
# Lifetime of email verification links
EMAIL_VERIFICATION_TTL_HOURS=24

# --- SMTP (used when EMAIL_TRANSPORT=smtp) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# For port 465 (implicit TLS), set SMTP_SECURE=true
# SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
# Gmail "App password" (16-letter code generated in Google Account > Security > 2FA > App passwords)
SMTP_PASSWORD=
SMTP_FROM_NAME="BP Learning"

# --- Rate limiting ---
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX_PER_IP=12
LOGIN_RATE_MAX_PER_EMAIL=8
AUTH_RATE_WINDOW_MS=3600000
AUTH_RATE_MAX_PER_IP=8

# --- Cookie security (auto-enabled in production) ---
# COOKIE_SECURE=true

# --- Development seed (npm run seed) ---
SEED_ADMIN_EMAIL=admin@bp-learning.local
# SEED_ADMIN_PASSWORD=
